{
  "name": "sandkiln-cli",
  "version": "0.2.0",
  "description": "CLI for sandkiln — manual testing, agentic workflows, and debugging for microVM sandboxes. Installs the `kiln` command.",
  "license": "MIT",
  "author": "Sumit Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SumitKumar-17/sandkiln.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "kiln": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "sandkiln": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
