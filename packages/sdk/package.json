{
  "name": "sandkiln",
  "version": "0.3.0",
  "description": "Client SDK for sandkiln: hardware-isolated Firecracker microVM sandboxes for running untrusted code.",
  "license": "MIT",
  "author": "Sumit Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SumitKumar-17/sandkiln.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/SumitKumar-17/sandkiln#readme",
  "bugs": "https://github.com/SumitKumar-17/sandkiln/issues",
  "keywords": [
    "sandbox",
    "firecracker",
    "microvm",
    "isolation",
    "untrusted-code",
    "vm"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
