---
// The homepage carries the shape of the surface, not its documentation: names
// and marks only. The roadmap page holds the full per-item detail and the
// docs hold the real reference, so repeating either here made the argument
// harder to read rather than better supported.
//
// Three states, not two: "partial" exists because several capabilities are
// genuinely built and running but reachable only through part of the surface
// (daemon but not the SDKs, say). Collapsing those into "done" overstates them
// and collapsing them into "planned" understates them — both were live bugs on
// this page before the split.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

interface Feature {
  status: "done" | "partial" | "planned";
  name: string;
}

const features: Feature[] = [
  { status: "done", name: "Isolation" },
  { status: "done", name: "Networking" },
  { status: "done", name: "Auth" },
  { status: "done", name: "Tags" },
  { status: "done", name: "File operations" },
  { status: "done", name: "Interactive terminal" },
  { status: "done", name: "Guest-accessible metadata" },
  { status: "done", name: "Per-sandbox I/O rate limiting" },
  { status: "done", name: "Durable sandbox history" },
  { status: "done", name: "Snapshot lineage" },
  { status: "done", name: "Observability" },
  { status: "done", name: "Snapshots & persistence" },
  { status: "done", name: "Drives" },
  { status: "done", name: "Auto-suspend on idle" },
  { status: "done", name: "Multi-agent isolation" },
  { status: "done", name: "Python SDK" },
  { status: "done", name: "Benchmarking" },

  // Partial, not shipped, and the roadmap says why: pool configuration is
  // in-memory only, and resuming has a real failure rate a health check has
  // to fall back from. This page said "shipped" while the roadmap said
  // "partial" — one of them had to be wrong.
  { status: "partial", name: "Pre-warmed pools" },
  { status: "partial", name: "JS/TS SDK" },
  { status: "partial", name: "CLI" },
  { status: "partial", name: "Remote storage mounts" },
  { status: "partial", name: "Time-travel restore" },
  { status: "partial", name: "Egress firewall" },
  { status: "partial", name: "Custom & managed images" },
  { status: "partial", name: "Jailer hardening" },

  { status: "planned", name: "Streamed output" },
  { status: "planned", name: "Seccomp filters & disk quotas" },
  { status: "planned", name: "System-privileged workloads" },
];

// Counted from the list rather than written down, so the tally cannot drift
// from the rows it describes.
const groups = [
  { status: "done" as const, title: "shipped", note: "verified on real hardware" },
  { status: "partial" as const, title: "partial", note: "built, with the gap stated" },
  { status: "planned" as const, title: "planned", note: "not built yet" },
].map((g) => ({ ...g, rows: features.filter((f) => f.status === g.status) }));
---

<section class="band band-ruled" id="surface">
  <div class="shell grid">
    <a class="rail" href="#surface">surface</a>
    <div class="col">
      <h2 class="head">
        <span class="l">Everything a sandbox needs,</span>
        <span class="l">marked by <span class="flare">what's actually true</span>.</span>
      </h2>
      <p class="lede prose">
        Three marks, because two would lie. A capability that runs but isn't reachable from
        every client says so here rather than hiding behind a filled square.
      </p>

      <div class="surface-groups">
        {groups.map((g) => (
          <div class={`sgroup sgroup-${g.status}`}>
            <div class="sgroup-head">
              <span class={`mark mark-${g.status}`}></span>
              <span class="sgroup-n">{g.rows.length}</span>
              <span>{g.title}</span>
              <span class="sgroup-note">{g.note}</span>
            </div>
            <ul class="sgroup-list">
              {g.rows.map((f) => <li>{f.name}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <p class="fine prose">
        Every item above, with what it does and exactly where it stops, is on the{" "}
        <a href={`${base}/roadmap/`}>roadmap</a>.
      </p>
    </div>
  </div>
</section>
