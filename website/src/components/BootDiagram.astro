---
// The four nodes are exactly the four steps enumerated below this component
// on the architecture page, and the travelling mark is the request itself
// moving through the real system. This is the only non-user-triggered motion
// on the site; it earns that by depicting an actual sequence rather than
// decorating one.
//
// The pulse crosses the rail over the first 75% of the loop at a linear rate,
// which is what lets each node's own highlight be delayed to the moment the
// pulse actually reaches it rather than approximately near it.
const nodes = [
  { x: 60, label: "Your call", sub: "POST /sandboxes" },
  { x: 220, label: "sandkilnd", sub: "leases tap + IP" },
  { x: 380, label: "Firecracker", sub: "boots a real kernel" },
  { x: 540, label: "guest-agent", sub: "binds vsock — ready" },
];

const TRAVEL_S = 4.8;
const delay = (i: number) => ((i / (nodes.length - 1)) * TRAVEL_S).toFixed(2);
---

<div class="boot">
  <svg viewBox="0 0 600 104" role="img" aria-label="A request travels from your code, through the sandkiln daemon, into a booting Firecracker microVM, to the guest agent inside it.">
    <line x1="60" y1="34" x2="540" y2="34" class="rail-line" />
    {nodes.map((n, i) => (
      <g class="node" style={`--d:${delay(i)}s`}>
        <circle cx={n.x} cy="34" r="6" class="ring" />
        <circle cx={n.x} cy="34" r="2.5" class="core" />
        <text x={n.x} y="64" class="label" text-anchor="middle">{n.label}</text>
        <text x={n.x} y="80" class="sub" text-anchor="middle">{n.sub}</text>
      </g>
    ))}
    <circle r="3.5" class="pulse" />
  </svg>
</div>

<style>
  .boot svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .rail-line {
    stroke: var(--rule);
    stroke-width: 1.5;
  }
  .ring {
    fill: var(--ground);
    stroke: var(--rule-strong);
    stroke-width: 1.5;
    animation: ring-hit 6.4s linear infinite var(--d);
  }
  .core {
    fill: var(--ink-3);
    animation: core-hit 6.4s linear infinite var(--d);
  }
  .label {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    fill: var(--ink);
  }
  .sub {
    font-family: var(--mono);
    font-size: 9px;
    fill: var(--ink-3);
  }

  .pulse {
    fill: var(--signal);
    offset-path: path("M60,34 L540,34");
    offset-rotate: 0deg;
    animation: travel 6.4s linear infinite;
  }

  @keyframes travel {
    0% { offset-distance: 0%; opacity: 0; }
    3% { opacity: 1; }
    72% { opacity: 1; }
    75% { offset-distance: 100%; opacity: 0; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  @keyframes ring-hit {
    0%, 6% { stroke: var(--signal); }
    12%, 100% { stroke: var(--rule-strong); }
  }
  @keyframes core-hit {
    0%, 6% { fill: var(--signal); }
    12%, 100% { fill: var(--ink-3); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse { display: none; }
    .ring, .core { animation: none !important; }
  }
</style>
