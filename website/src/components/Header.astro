---
interface Props {
  active?: "home" | "architecture" | "performance" | "roadmap" | "changelog" | "docs";
}
const { active } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => (path === "" ? `${base}/` : `${base}/${path}/`);

const nav = [
  { label: "Architecture", path: "architecture", key: "architecture" },
  { label: "Performance", path: "performance", key: "performance" },
  { label: "Roadmap", path: "roadmap", key: "roadmap" },
  { label: "Changelog", path: "changelog", key: "changelog" },
  { label: "Docs", path: "docs", key: "docs" },
];
---

<header class="masthead">
  <div class="shell masthead-in">
    <a class="wordmark" href={link("")}>sandkiln<span class="stop">.</span></a>

    <nav class="nav" aria-label="Main">
      {nav.map((item) => (
        <a href={link(item.path)} aria-current={active === item.key ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>

    <a class="icon-btn" href="https://github.com/SumitKumar-17/sandkiln" aria-label="Source on GitHub">
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="currentColor">
        <path d="M8 0C3.58 0 0 3.67 0 8.2c0 3.62 2.29 6.7 5.47 7.78.4.08.55-.18.55-.39 0-.19-.01-.82-.01-1.49-2.01.38-2.53-.5-2.7-.96-.09-.24-.48-.96-.82-1.16-.28-.15-.68-.53-.01-.54.63-.01 1.08.59 1.23.83.72 1.24 1.87.89 2.33.68.07-.53.28-.89.51-1.1-1.78-.2-3.64-.91-3.64-4.02 0-.89.31-1.62.82-2.19-.08-.2-.36-1.04.08-2.16 0 0 .67-.22 2.2.84a7.4 7.4 0 0 1 4 0c1.53-1.06 2.2-.84 2.2-.84.44 1.12.16 1.96.08 2.16.51.57.82 1.29.82 2.19 0 3.12-1.87 3.82-3.65 4.02.29.26.54.76.54 1.53 0 1.11-.01 2-.01 2.27 0 .21.15.48.55.39A8.21 8.21 0 0 0 16 8.2C16 3.67 12.42 0 8 0Z" />
      </svg>
    </a>
    <button class="icon-btn theme-toggle" type="button" aria-label="Switch between light and dark theme">
      <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.8v2.2M12 19v2.2M2.8 12h2.2M19 12h2.2M5.5 5.5l1.6 1.6M16.9 16.9l1.6 1.6M18.5 5.5l-1.6 1.6M7.1 16.9l-1.6 1.6" stroke-linecap="round" />
      </svg>
    </button>

    {/* Below the nav breakpoint the marketing pages previously had no
        navigation at all. A disclosure keeps that fix JavaScript-free. */}
    <details class="menu">
      <summary aria-label="Open navigation">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="menu-sheet">
        {nav.map((item) => (
          <a href={link(item.path)} aria-current={active === item.key ? "page" : undefined}>{item.label}</a>
        ))}
      </div>
    </details>
  </div>
</header>

<script>
  // Writes the same localStorage key Starlight's own toggle uses, so the
  // choice carries in both directions across the two halves of the site.
  (function () {
    var button = document.querySelector(".theme-toggle");
    if (!(button instanceof HTMLButtonElement)) return;
    button.addEventListener("click", function () {
      var root = document.documentElement;
      var isDark = root.dataset.theme
        ? root.dataset.theme === "dark"
        : window.matchMedia("(prefers-color-scheme: dark)").matches;
      var next = isDark ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("starlight-theme", next);
      } catch {}
    });

    var menu = document.querySelector(".menu");
    if (menu instanceof HTMLDetailsElement) {
      document.addEventListener("click", function (event) {
        if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
      });
      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && menu.open) menu.open = false;
      });
    }
  })();
</script>
