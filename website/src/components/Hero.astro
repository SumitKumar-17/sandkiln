---
import { ticks, markStyle, type Measurement } from "../lib/scale";

// Every figure is one recorded in ROADMAP.md's Benchmarking section. No
// rounded midpoints: a range is published as a range, because the prettier
// single number in the middle of it was never actually measured.
const readout: Measurement[] = [
  { label: "ready for first command", lo: 214.5, hi: 214.5, value: "214", unit: "ms", source: "create to first exec, mean of 20 cold sandboxes" },
  { label: "exec round-trip", lo: 0.242, hi: 0.248, value: "242–248", unit: "µs", source: "criterion, over an open vsock" },
  { label: "resume from snapshot", lo: 3.7, hi: 4.0, value: "3.7–4.0", unit: "ms", source: "criterion, 2026-11-23" },
  { label: "create returns", lo: 16.4, hi: 16.4, value: "16.4", unit: "ms", source: "mean of 20 cold creates, reflinked rootfs" },
];

const consoleLines = [
  { t: "[    0.000000] Linux version 5.10.223 (gcc 11.4.0) #1 SMP", c: "dim" },
  { t: "[    0.000000] Command line: console=ttyS0 reboot=k panic=1", c: "dim" },
  { t: "[    0.000000] Hypervisor detected: KVM", c: "sig" },
  { t: "[    0.005803] Booting paravirtualized kernel on KVM", c: "" },
  { t: "[    0.046087] smp: Brought up 1 node, 2 CPUs", c: "" },
  { t: "[    0.214030] virtio_blk virtio0: [vda] 300 MiB", c: "" },
  { t: "[    0.259624] VFS: Mounted root (ext4) on device 254:0", c: "sig" },
  { t: "[    0.279281] Run /sbin/init as init process", c: "" },
  { t: "[    0.302006] systemd[1]: systemd 249.11 running", c: "" },
  { t: "         Starting sandkiln-agent.service...", c: "dim" },
  { t: "[  OK  ] Started sandkiln-agent.service", c: "ok" },
  { t: "", c: "" },
  { t: "Ubuntu 22.04.5 LTS ubuntu-fc-uvm ttyS0", c: "" },
  { t: "ubuntu-fc-uvm login: root (automatic login)", c: "ok" },
];
---

<section class="hero">
  <div class="shell hero-layout">
    <div class="hero-text">
      <h1>
        <span class="l">Run untrusted code on</span>
        <span class="l">hardware <span class="flare">you control</span>.</span>
      </h1>
      <p class="hero-sub">
        Every execution gets its own Firecracker microVM. Its own kernel, its own filesystem,
        its own network. Not a container with extra steps.
      </p>
      <p class="hero-fine">
        A Rust VMM, a static guest agent on vsock, an HTTP daemon driving both. Self-hosted,
        MIT licensed, benchmarked in the open.
      </p>

      <div class="actions">
        <button class="btn btn-primary copy-install" type="button" data-copy="npm install sandkiln">
          <span class="copy-label">npm install sandkiln</span>
        </button>
        <a class="btn btn-quiet" href="https://sandkiln.mintlify.site/getting-started/self-hosting">Self-hosting quickstart</a>
      </div>
      <p class="sr-live" role="status" aria-live="polite"></p>
    </div>

    <div class="hero-visual">
      <div class="tty hero-console">
        <div class="tty-head">
          <span>guest console — ttyS0</span>
          <span class="live">12.6–14.0ms to InstanceStart</span>
        </div>
        <pre>{consoleLines.map((l, i) => <div class={`cl ${l.c}`} style={`--d:${(i * 0.09).toFixed(2)}s`}>{l.t || " "}</div>)}</pre>
      </div>

      <div class="gauges">
        {readout.map((m) => (
          <div class="gauge">
            <div class="gauge-label">{m.label}</div>
            <div class="gauge-val">{m.value}<span class="u">{m.unit}</span></div>
            <div class="gauge-track" aria-hidden="true">
              {ticks.map((t) => <span class="gauge-decade" style={`left:${t.at}%`}></span>)}
              <span class={`gauge-mark${m.lo === m.hi ? " gauge-mark-point" : ""}`} style={markStyle(m)}></span>
            </div>
            <div class="gauge-src">{m.source}</div>
          </div>
        ))}
      </div>
      <p class="gauge-legend">
        Every track is the same log axis, {ticks[0].label} to {ticks[ticks.length - 1].label}, one tick
        per decade — so the marks compare directly. One dev box, single node.
      </p>
    </div>
  </div>
</section>

<script>
  // The install command is the first thing a reader wants out of this page,
  // so the button hands it over rather than scrolling them somewhere to
  // select it by hand. The label states what happened, in the same words.
  (function () {
    var button = document.querySelector(".copy-install");
    if (!(button instanceof HTMLButtonElement)) return;
    var label = button.querySelector(".copy-label");
    var live = document.querySelector(".sr-live");
    var command = button.dataset.copy || "";
    var original = label ? label.textContent : "";
    var timer: number | undefined;

    button.addEventListener("click", function () {
      navigator.clipboard.writeText(command).then(
        function () {
          if (label) label.textContent = "Copied";
          if (live) live.textContent = "Copied " + command + " to the clipboard";
          window.clearTimeout(timer);
          timer = window.setTimeout(function () {
            if (label) label.textContent = original;
            if (live) live.textContent = "";
          }, 2000);
        },
        function () {
          if (live) live.textContent = "Couldn't copy. The command is: " + command;
        },
      );
    });
  })();
</script>

<style>
  .copy-install {
    min-width: 226px;
    justify-content: flex-start;
  }
  .sr-live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
