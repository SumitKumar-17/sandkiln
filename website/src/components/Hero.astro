---
// Every figure here is one recorded in ROADMAP.md's Benchmarking section. No
// rounded midpoints: a range is published as a range, because the single
// prettier number in the middle of it was never actually measured.
const readout = [
  { label: "Cold boot", value: "32.3–33.1", unit: "ms", note: "criterion, spawn to InstanceStart" },
  { label: "Exec round-trip", value: "225–275", unit: "µs", note: "over an open vsock connection" },
  { label: "Resume from snapshot", value: "25.5–26.2", unit: "ms", note: "criterion" },
  { label: "Full create, under load", value: "211", unit: "ms", note: "mean, 4 concurrent workers" },
];

const console_lines = [
  { t: "[    0.000000] Linux version 5.10.223 (gcc 11.4.0) #1 SMP", c: "dim" },
  { t: "[    0.000000] Command line: console=ttyS0 reboot=k panic=1", c: "dim" },
  { t: "[    0.000000] Hypervisor detected: KVM", c: "sig" },
  { t: "[    0.005803] Booting paravirtualized kernel on KVM", c: "" },
  { t: "[    0.046087] smp: Brought up 1 node, 2 CPUs", c: "" },
  { t: "[    0.214030] virtio_blk virtio0: [vda] 300 MiB", c: "" },
  { t: "[    0.259624] VFS: Mounted root (ext4) on device 254:0", c: "ok" },
  { t: "[    0.279281] Run /sbin/init as init process", c: "" },
  { t: "[    0.302006] systemd[1]: systemd 249.11 running", c: "" },
  { t: "         Starting sandkiln-agent.service...", c: "sig" },
  { t: "[  OK  ] Started sandkiln-agent.service", c: "ok" },
  { t: "", c: "" },
  { t: "Ubuntu 22.04.5 LTS ubuntu-fc-uvm ttyS0", c: "" },
  { t: "ubuntu-fc-uvm login: root (automatic login)", c: "sig" },
];
---

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>Run untrusted code<br />without flinching.</h1>
      <p class="tagline">A compute primitive for safely executing untrusted or AI-generated code. Every run gets its own Firecracker microVM — its own kernel, its own filesystem, its own network.</p>
      <p class="lede">Built from the metal up: a Rust VMM, a static guest agent talking over vsock, an HTTP daemon driving it all. No shell scripts in the hot path, no container escape surface.</p>

      <div class="cta-row">
        <a class="btn primary" href="#code">npm install sandkiln</a>
        <a class="btn ghost" href="architecture/">Read the architecture</a>
      </div>
    </div>

    <div class="panel-stack">
      <div class="readout" role="group" aria-label="Measured latency">
        {readout.map((r) => (
          <div class="readout-row">
            <span class="r-label">{r.label}</span>
            <span class="r-value">{r.value}<span class="r-unit">{r.unit}</span></span>
            <span class="r-note">{r.note}</span>
          </div>
        ))}
      </div>

      <div class="console">
        <div class="console-bar"><span class="console-title">guest console</span><span class="console-meta">ttyS0</span></div>
        <pre>{console_lines.map((l) => <div class={l.c}>{l.t || " "}</div>)}</pre>
      </div>
    </div>
  </div>
</section>
