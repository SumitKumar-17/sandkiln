<style>
  #embers { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
</style>

<script>
  (function () {
    var canvas = document.getElementById("embers");
    if (!(canvas instanceof HTMLCanvasElement)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var ctx = canvas.getContext("2d");
    if (!ctx) return;

    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    function resize() {
      var rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
    }
    resize();
    window.addEventListener("resize", resize);

    var accent = ["#ff8a4c", "#ff5a24", "#ffb28e"];
    function makeEmber() {
      var w = canvas.width, h = canvas.height;
      return {
        x: w * (0.15 + Math.random() * 0.7),
        y: h + 10,
        r: (1 + Math.random() * 2) * dpr,
        vy: (0.25 + Math.random() * 0.5) * dpr,
        vx: (Math.random() - 0.5) * 0.35 * dpr,
        life: 0,
        maxLife: 140 + Math.random() * 120,
        color: accent[Math.floor(Math.random() * accent.length)],
      };
    }
    var embers = [];
    for (var i = 0; i < 22; i++) {
      var e = makeEmber();
      e.y = Math.random() * canvas.height;
      embers.push(e);
    }

    function tick() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (var j = 0; j < embers.length; j++) {
        var em = embers[j];
        em.life++;
        em.x += em.vx;
        em.y -= em.vy;
        var fade = 1 - em.life / em.maxLife;
        if (fade <= 0 || em.y < -10) {
          embers[j] = makeEmber();
          continue;
        }
        ctx.globalAlpha = Math.max(0, fade) * 0.85;
        ctx.fillStyle = em.color;
        ctx.beginPath();
        ctx.arc(em.x, em.y, em.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();
</script>

<script>
  (function () {
    var lines = [
      { t: '[    0.000000] <span class="k">Linux version 5.10.223 (gcc 11.4.0) #1 SMP</span>' },
      { t: '[    0.000000] <span class="k">Command line: console=ttyS0 reboot=k panic=1</span>' },
      { t: '[    0.000000] <span class="hl">Hypervisor detected: KVM</span>' },
      { t: '[    0.005803] Booting paravirtualized kernel on KVM' },
      { t: '[    0.046087] smp: Brought up 1 node, 2 CPUs' },
      { t: '[    0.214030] virtio_blk virtio0: [vda] 300 MiB' },
      { t: '[    0.259624] <span class="ok">VFS: Mounted root (ext4) on device 254:0</span>' },
      { t: '[    0.279281] Run /sbin/init as init process' },
      { t: '[    0.302006] systemd[1]: systemd 249.11 running' },
      { t: '         Starting <span class="hl">sandkiln-agent.service</span>...' },
      { t: '<span class="ok">  OK  </span> Started sandkiln-agent.service' },
      { t: '' },
      { t: 'Ubuntu 22.04.5 LTS ubuntu-fc-uvm ttyS0' },
      { t: 'ubuntu-fc-uvm login: <span class="hl">root</span> (automatic login)' },
      { t: '' },
      { t: '<span class="ok">agent</span>@sandkiln:~$ <span class="hl">boot complete — 32.7ms</span><span class="cursor"></span>' },
    ];
    var out = document.getElementById("term-out");
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!out) return;
    if (reduced) {
      out.innerHTML = lines.map(function (l) { return l.t; }).join("\n");
      return;
    }
    var i = 0;
    function next() {
      if (i >= lines.length) return;
      var div = document.createElement("div");
      div.innerHTML = lines[i].t;
      out.appendChild(div);
      i++;
      var el = document.getElementById("term");
      if (el) el.scrollTop = el.scrollHeight;
      setTimeout(next, i === lines.length ? 0 : 28 + Math.random() * 70);
    }
    setTimeout(next, 300);
  })();
</script>
