---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const links = [
  { kind: "Architecture", href: `${base}/architecture/`, name: "Five crates, the boot lifecycle, and why it's shaped this way" },
  { kind: "Performance", href: `${base}/performance/`, name: "Measured numbers, what they cost, and where the remaining gap actually lives" },
  { kind: "Roadmap", href: `${base}/roadmap/`, name: "What's shipped, what's partial, and what hasn't been started" },
  { kind: "Docs", href: `${base}/docs/`, name: "Full API reference, task guides, and self-hosting instructions" },
];
---

<section class="band band-ruled" id="more">
  <div class="shell grid">
    <a class="rail" href="#more">further</a>
    <div class="col">
      <h2 class="head">
        <span class="l">The parts that don't fit</span>
        <span class="l">on <span class="flare">a homepage</span>.</span>
      </h2>
      <div class="jump">
        {links.map((l) => (
          <a href={l.href}>
            <span class="jump-kind">{l.kind}</span>
            <span class="jump-name">{l.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
