---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("engineering")).sort((a, b) => a.data.order - b.data.order);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const toc = headings.filter((h) => h.depth === 2);
const updated = post.data.updated.toISOString().slice(0, 10);
---

<BaseLayout title={`${post.data.title} — sandkiln engineering`} description={post.data.summary}>
  <Header active="engineering" />
  <main>
    <article class="shell post">
      <a class="back" href={`${base}/engineering/`}>← all posts</a>
      <h1>{post.data.title}</h1>
      <p class="meta">{post.data.tags.join(" · ")} · updated {updated}</p>
      <p class="lede">{post.data.summary}</p>
      <div class="post-layout">
        <nav class="toc" aria-label="On this page">
          {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
        </nav>
        <div class="prose body"><Content /></div>
      </div>
      <nav class="pager">
        {prev && <a href={`${base}/engineering/${prev.id}/`}>← {prev.data.title}</a>}
        {next && <a class="next" href={`${base}/engineering/${next.id}/`}>{next.data.title} →</a>}
      </nav>
    </article>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Mermaid fences render as diagrams; everything else is untouched. Loaded
  // lazily and only on pages that actually contain a diagram.
  const blocks = Array.from(document.querySelectorAll<HTMLElement>("pre[data-language='mermaid']"));
  if (blocks.length) {
    const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const run = async () => {
      const url = "https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs";
      const { default: mermaid } = await import(/* @vite-ignore */ url);
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "strict",
        theme: "base",
        themeVariables: {
          fontFamily: "Azeret Mono, ui-monospace, monospace",
          background: css("--ground"),
          primaryColor: css("--flare-wash"),
          primaryTextColor: css("--ink"),
          primaryBorderColor: css("--flare"),
          lineColor: css("--ink-3"),
          secondaryColor: css("--well"),
          tertiaryColor: css("--ground"),
        },
      });
      for (const [i, pre] of blocks.entries()) {
        try {
          const { svg } = await mermaid.render(`diagram-${i}`, pre.textContent ?? "");
          const figure = document.createElement("figure");
          figure.className = "diagram";
          figure.innerHTML = svg;
          pre.replaceWith(figure);
        } catch (e) {
          console.warn("mermaid failed to render a diagram", e);
        }
      }
    };
    run();
  }
</script>

<style is:global>
  .post { padding-block: clamp(32px, 5vw, 72px); }
  .post .back { font-size: var(--t-micro); color: var(--ink-3); text-decoration: none; }
  .post h1 { font-size: var(--t-title); line-height: 1.1; letter-spacing: -0.04em; margin-top: var(--s-4); max-width: 26ch; }
  .post .meta { font-size: var(--t-micro); color: var(--ink-3); margin-top: var(--s-3); }
  .post .lede { margin-top: var(--s-4); max-width: 64ch; }
  .post-layout { display: grid; gap: var(--s-6); margin-top: var(--s-7); }
  @media (min-width: 1100px) { .post-layout { grid-template-columns: 220px minmax(0, 76ch); } }
  .toc { display: none; }
  @media (min-width: 1100px) {
    .toc { display: flex; flex-direction: column; gap: var(--s-3); position: sticky; top: 88px; align-self: start; border-top: 1px solid var(--rule-strong); padding-top: var(--s-3); }
    .toc a { font-size: var(--t-micro); color: var(--ink-3); text-decoration: none; }
    .toc a:hover { color: var(--flare); }
  }
  .post .body h2 { margin-top: var(--s-7); font-size: 1.5rem; letter-spacing: -0.03em; }
  .post .body h3 { margin-top: var(--s-6); font-size: 1.1rem; }
  .post .body p, .post .body li { line-height: 1.7; }
  .post .body pre { overflow-x: auto; padding: var(--s-4); border: 1px solid var(--rule); font-size: 0.82rem; line-height: 1.55; }
  .post .body :not(pre) > code { background: var(--flare-wash); padding: 0.1em 0.35em; }
  .post .body table { border-collapse: collapse; width: 100%; font-size: 0.88rem; display: block; overflow-x: auto; }
  .post .body th, .post .body td { text-align: left; padding: var(--s-2) var(--s-3); border-bottom: 1px solid var(--rule); vertical-align: top; }
  .post .body th { color: var(--ink-3); font-weight: 500; }
  .post .body figure.diagram { margin: var(--s-6) 0; padding: var(--s-4); border: 1px solid var(--rule); overflow-x: auto; background: var(--ground); }
  .post .body figure.diagram svg { max-width: 100%; height: auto; }
  .pager { display: flex; justify-content: space-between; gap: var(--s-4); margin-top: var(--s-8); padding-top: var(--s-5); border-top: 1px solid var(--rule-strong); font-size: var(--t-micro); }
  .pager a { color: var(--ink-2); text-decoration: none; }
  .pager a:hover { color: var(--flare); }
  .pager .next { margin-left: auto; text-align: right; }
</style>
