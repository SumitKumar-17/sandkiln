---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BootDiagram from "../components/BootDiagram.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Five crates are a dependency stack, not a sequence, so the structural fact
// worth stating is what each one depends on — not an ordinal. The `uses`
// column is the real edge set from each crate's Cargo.toml.
const crates = [
  {
    name: "sandkiln-protocol",
    role: "The wire format shared by host and guest — length-prefixed JSON, kept dependency-light so neither side reaches into the other.",
    uses: "nothing",
  },
  {
    name: "sandkiln-guest-agent",
    role: "Runs inside the microVM as a systemd service. Listens on vsock and answers exec, read, write and list. A static musl binary.",
    uses: "protocol",
  },
  {
    name: "sandkiln-vmm",
    role: "Drives Firecracker directly: boot, snapshot and resume, network leasing, drives, the vsock client. A hand-rolled HTTP client talks to Firecracker's API socket.",
    uses: "protocol",
  },
  {
    name: "sandkiln-store",
    role: "A small sqlite-backed crate for durable sandbox history — the record of every sandbox that ever existed and how it ended, surviving a daemon restart the live sandbox map never could.",
    uses: "nothing",
  },
  {
    name: "sandkiln-daemon",
    role: "The axum + tokio HTTP API wrapping the lifecycle — create, exec, list, stop, snapshot, images, drives, pools — with auth, tags and tracing built in from the start.",
    uses: "protocol, vmm, store",
  },
];

const steps = [
  { n: "01", title: "Lease", body: "A tap device and IP are leased from the pool and attached to the bridge — concurrently with the rootfs clone, not after it." },
  { n: "02", title: "Boot", body: "Firecracker starts; boot-source, drive, machine-config and vsock are configured over its API socket." },
  { n: "03", title: "Agent up", body: "The guest kernel boots, systemd starts the guest agent, and it binds its vsock port." },
  { n: "04", title: "Ready", body: "The host's vsock client connects. The sandbox can now run anything you send it." },
];

const essays = [
  { kind: "Jailer & privilege model", href: `${base}/docs/internals/jailer-privilege-model/`, name: "Chroot, cgroups, setuid, and a root that stays out of the hot path" },
  { kind: "Wire protocol", href: `${base}/docs/internals/vsock-wire-protocol/`, name: "vsock, a length-prefixed JSON frame, and a client that doesn't reach for a full HTTP stack" },
  { kind: "Snapshot, resume, fork", href: `${base}/docs/internals/snapshot-resume-fork/`, name: "Why a snapshot points at paths instead of carrying values, and the rootfs bug that taught us that" },
  { kind: "Bug hunt", href: `${base}/docs/architecture/bug-hunt-vsock-timeout/`, name: "The vsock timeout that could hang a stop forever" },
];
---

<BaseLayout title="Architecture — sandkiln">
  <Header active="architecture" />

  <main>
    <section class="page-hero">
      <div class="shell page-hero-layout">
        <div>
          <h1>
            <span class="l">Five crates. None reaches</span>
            <span class="l">into <span class="flare">another's internals</span>.</span>
          </h1>
          <p class="lede">
            The core is a Rust workspace kept deliberately modular: the daemon can change without
            touching the guest agent, and the guest agent ships as its own static binary,
            independent of everything that talks to it.
          </p>
        </div>
        <nav class="page-hero-nav" aria-label="On this page">
          <a href="#crates">workspace</a>
          <a href="#boot">lifecycle</a>
          <a href="#rationale">rationale</a>
        </nav>
      </div>
    </section>

    <section class="band band-ruled" id="crates">
      <div class="shell grid">
        <a class="rail" href="#crates">workspace</a>
        <div class="col">
          <h2 class="head">
            <span class="l">Five crates, and exactly</span>
            <span class="l">what each one <span class="flare">owns</span>.</span>
          </h2>
          <div class="stack">
            <div class="crate crate-legend">
              <span>crate</span><span>what it owns</span><span class="crate-uses">depends on</span>
            </div>
            {crates.map((c) => (
              <div class="crate">
                <span class="crate-name">{c.name}</span>
                <span class="crate-role">{c.role}</span>
                <span class="crate-uses">{c.uses}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="band band-ruled" id="boot">
      <div class="shell grid">
        <a class="rail" href="#boot">lifecycle</a>
        <div class="col">
          <h2 class="head">
            <span class="l">What actually happens</span>
            <span class="l">inside <span class="flare">a create</span>.</span>
          </h2>
          <BootDiagram />
          <div class="steps">
            {steps.map((s) => (
              <div class="step">
                <div class="step-n">{s.n}</div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="band band-ruled" id="rationale">
      <div class="shell grid">
        <a class="rail" href="#rationale">rationale</a>
        <div class="col">
          <h2 class="head">
            <span class="l">Why it's built this way,</span>
            <span class="l">and <span class="flare">what broke before</span>.</span>
          </h2>
          <p class="lede prose">
            The full essays live in the docs, next to the API they explain — four below, and ten
            more covering everything from SQLite to token-bucket rate limiting under
            <strong>Internals</strong> in the sidebar.
          </p>
          <div class="jump">
            {essays.map((e) => (
              <a href={e.href}>
                <span class="jump-kind">{e.kind}</span>
                <span class="jump-name">{e.name}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
